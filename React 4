// Import React and the useState hook from React
import React, { useState } from "react";

// Import a clipboard icon from the react-icons library
import { BsFillClipboardPlusFill } from "react-icons/bs";

// These commented icons are unused but show other available icons
// BsFillClipboardPlusFill
// BsPencilSquare

// CreateArea is a React component that receives props from its parent
function CreateArea(props) {

  // useState creates state to store the current note being typed
  // note contains two fields: title and content
  const [note, setNote] = useState({
    title: "",
    content: ""
  });

  // This function runs whenever the user types in the input or textarea
  function handleChange(event) {

    // Extract the name and value from the input field
    // name = "title" or "content"
    // value = whatever the user types
    const { name, value } = event.target;

    // Update the note state
    setNote((prevNote) => {
      return {

        // Copy previous note values
        ...prevNote,

        // Update the specific field (title or content)
        // [name] dynamically sets the property
        [name]: value
      };
    });
  }

  // This function runs when the button is clicked
  function submitNote(event) {

    // Send the current note to the parent component
    // props.onAdd is a function passed from App.js
    props.onAdd(note);

    // Reset the note fields after submission
    setNote({
      title: "",
      content: ""
    });

    // Prevent the form from refreshing the page
    event.preventDefault();
  }

  // JSX that renders the UI
  return (
    <div>

      {/* Form for creating a note */}
      <form className="create-note">

        {/* Input field for the note title */}
        <input
          name="title"               // identifies the field
          onChange={handleChange}    // runs handleChange when typing
          value={note.title}         // controlled input (value from state)
          placeholder="Title"
        />

        {/* Textarea for the note content */}
        <textarea
          name="content"             // identifies the field
          onChange={handleChange}    // updates state when typing
          value={note.content}       // controlled input
          placeholder="Take a note..."
          rows="3"
        />

        {/* Button that submits the note */}
        <button onClick={submitNote}>

          {/* Clipboard icon inside the button */}
          <BsFillClipboardPlusFill />

        </button>

      </form>
    </div>
  );
}

// Export the component so it can be used in other files
export default CreateArea;
  );
}

export default CreateArea;
